control = list(maxit = 1000, reltol = 1e-16))
})
prob_massf <- function(theta1, theta2, theta3, x){
tmp1 <- exp(theta1*x[[1]] + theta2*x[[2]] + theta3*x[[1]]*x[[2]])
tmp2 <- 1 + exp(theta1) + exp(theta2) + exp(theta1 + theta2 + theta3)
tmp1/tmp2
}
theta1 <- .3
theta2 <- theta1
theta3 <- -1
prob_mat <- matrix(NA, ncol=2, nrow=2)
for(i in 0:1){
for(j in 0:1){
prob_mat[i + 1, j + 1] <- prob_massf(theta1, theta2, theta3, c(i, j))
}
}
set.seed(2135)
n <- 10e4
values <- list(c(0, 0), c(0, 1), c(1, 0), c(1, 1))
indices <- sample(1:4, size = n, replace = TRUE, prob = c(prob_mat))
samples <- vector("list", length=n)
for(i in 1:n){
samples[[i]] <- values[[indices[[i]]]]
}
NlikelihoodF <- function(thetas, prob_massf=prob_massf, samples=samples){
-purrr::reduce(
log(purrr::map_dbl(samples, \(x) prob_massf(theta1=thetas[[1]],
theta2=thetas[[1]],
theta3=thetas[[2]], x))),
sum
)
}
starts <- list(c(-6, -3))#, c(0, 10), c(-2, 7), c(10, 10))
results <- lapply(starts, function(s) {
optim(par = s, fn = NlikelihoodF,
prob_massf=prob_massf, samples=samples,
method = "BFGS",
hessian = TRUE,
control = list(maxit = 1000, reltol = 1e-16))
})
purrr::walk(1:length(results), \(i) cat("MLE Estimate", i,": ", results[[i]][["par"]], "\n"))
