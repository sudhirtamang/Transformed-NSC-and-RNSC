Green point is the Ture value of the parameter",
side = 1, line = 4, adj = 0, cex = 0.7, font = 3)
mle_vec <- results[[1]]$par
V <- solve(results[[1]]$hessian)
cutoff <- qchisq(0.99, df = 2)
plot(1, 1, )
region_points <- ellipse(V, centre = mle_vec, level = 0.99)
plot(region_points, type = 'l', lwd = 2, col = "darkblue",
xlab = expression(theta[1]), ylab = expression(theta[3]),
font.main = 2,
main = bquote("99% Confidence Region (True" ~ bold(theta) == "(" * .(theta1) * "," ~ .(theta2) * "," ~ .(theta3) * "))"))
polygon(region_points, col = "lightblue", border = "darkblue", lwd = 2)
points(mle_vec[1], mle_vec[2], pch = 19, col = "red")
